# galaius configuration — all optional (galaius runs zero-config). Copy to `.env` for a
# project-local override, or set the same keys in ~/.galaius/config.env (via `galaius` / the
# config TUI) for a user-wide one. Your real `.env` is gitignored — keep API keys here, never commit.
#
# Precedence (first wins):  host env  >  ~/.galaius/config.env  >  project .env  >  built-in defaults
# So anything "dev-specific" you don't want baked into the codebase lives HERE and overrides the
# clean defaults — colleagues who don't set it get the production behaviour.

# --- Vision model + provider keys (only needed for the VLM analysis features) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# GEMINI_API_KEY=...
# GALAIUS_IMAGE_MODEL=          # e.g. gemini/gemini-2.5-flash — empty = tested recommendation
# GALAIUS_VIDEO_MODEL=
# GALAIUS_COMPONENT_MODEL=      # element detection; falls back to the image model when empty

# --- Browser ---
# GALAIUS_HEADLESS=true
# GALAIUS_BROWSER_TYPE=chromium # chromium | firefox | webkit
# GALAIUS_SESSION_IDLE_TTL=900  # auto-close a browser session idle this many seconds (frees its
#                                # Chromium; re-opens fresh on next use). 0 = never auto-close.

# --- Desktop sandbox (Linux/X11) ---
# GALAIUS_DESKTOP_TARGET=local  # local (real session) | nested (isolated Xephyr/Xvfb)
# GALAIUS_NESTED_DISPLAY=99
# GALAIUS_NESTED_SIZE=1280x800
# GALAIUS_NESTED_HEADLESS=false # true → Xvfb (servers/CI, no window); false → Xephyr (watch it)

# --- Output / debug ---
# GALAIUS_DEBUG_DIR=~/.galaius # usage log + screenshot dumps relocate with this

# --- DEV ONLY — run a local galaius checkout instead of the released build ---
# The VS Code extension (and `galaius.projectPath` setting) reads this to run your working tree
# via `uv run`. Leave UNSET for any normal/colleague install so the released build is used; it is
# never auto-detected from an open workspace.
# GALAIUS_PROJECT_PATH=~/dev/galaius

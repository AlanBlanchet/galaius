[Unit]
Description=Interact workflow machine connection
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Slice=interact-agents.slice
ExecStart=%h/.local/bin/interact machine connect
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target

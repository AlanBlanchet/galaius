#!/usr/bin/env bash
# Tracked git hook (configured via `git config core.hooksPath .githooks`).
set -e

# 0) Public repository: no private material in a commit (the pre-push hook re-checks at push time).
#    Added lines only; terms live in <git-common-dir>/info/private-terms, which git never tracks.
_added="$(git diff --cached --no-color -U0 | grep -E '^\+' | grep -Ev '^\+\+\+' || true)"
_terms_file="$(git rev-parse --path-format=absolute --git-common-dir)/info/private-terms"
_terms=""
[ -f "$_terms_file" ] && _terms="$(grep -Ev '^[[:space:]]*(#|$)' "$_terms_file" | paste -sd '|' -)"
_private="$(printf '%s\n' "$_added" | grep -E '/ho''me/[a-z_][a-z0-9_-]*/|"slash''_commands"' || true)"
[ -n "$_terms" ] && _private="${_private}$(printf '%s\n' "$_added" | grep -iE "$_terms" || true)"
if [ -n "$(printf '%s' "$_private" | tr -d '[:space:]')" ]; then
    echo "[hook] FAIL: private material in a public repository commit:"
    printf '%s\n' "$_private" | head -5 | cut -c1-160
    exit 1
fi

# 1) Version single-source-of-truth: pyproject.toml and the VS Code extension must agree.
#    Stops a half-bumped commit before it reaches CI (which would refuse to tag).
py=$(sed -nE 's/^version *= *"([^"]+)".*/\1/p' pyproject.toml | head -1)
ext=$(sed -nE 's/.*"version" *: *"([^"]+)".*/\1/p' clients/vscode/package.json | head -1)
if [ -n "$ext" ] && [ "$py" != "$ext" ]; then
    echo "[hook] FAIL: version mismatch — pyproject.toml=$py but clients/vscode/package.json=$ext"
    echo "[hook]   fix both at once:  python -m interact.versioning bump <major|minor|patch>"
    exit 1
fi

# git runs hooks with a minimal PATH (the login shell — incl. nvm's shims — isn't sourced), which
# is why node/npm/npx/json2ts were "not found" here. Load the user's nvm default the same way an
# interactive shell would, so the node steps below behave identically. Returns non-zero (handled
# by callers) if node still can't be found, so the commit degrades gracefully offline / in CI.
_load_node() {
    command -v node >/dev/null 2>&1 && return 0
    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
    if [ -s "$NVM_DIR/nvm.sh" ]; then
        set +e  # nvm.sh can emit non-zero lines; don't let `set -e` abort the commit
        # shellcheck disable=SC1091
        . "$NVM_DIR/nvm.sh" --no-use >/dev/null 2>&1
        nvm use default >/dev/null 2>&1 || nvm use node >/dev/null 2>&1
        set -e
    fi
    command -v node >/dev/null 2>&1
}

# 2) Regenerate TS bindings when the Pydantic API surface changes (keeps the committed
#    generated/types.ts in lock-step with the models).
if git diff --cached --name-only | grep -qE '^src/interact/(models|formats|api_types)\.py$|^src/interact/benchmarks/(published|upstream)\.py$|^pyproject\.toml$|^clients/vscode/scripts/generate-types\.sh$'; then
    if _load_node; then
        echo "[hook] Pydantic API changed — regenerating TS types..."
        if bash clients/vscode/scripts/generate-types.sh >/dev/null 2>&1; then
            git add clients/vscode/src/generated/types.ts clients/vscode/src/generated/promptContracts.ts 2>/dev/null || true
        else
            echo "[hook] WARN: type generation failed, continuing"
        fi
    else
        echo "[hook] WARN: node not found (nvm not loadable) — skipping TS type regen"
    fi
fi

# 3) Provider-independent staged-content and workflow-evidence gates. Run after generators that
#    can mutate the index, so every reviewed candidate must include their output.
git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null) || {
    echo "[hook] FAIL: cannot resolve repository Git directory"
    exit 1
}
gate_exec=$(mktemp "$git_dir/interact-repository-gate.XXXXXX") || {
    echo "[hook] FAIL: cannot create private staged-gate artifact"
    exit 1
}
chmod 0600 "$gate_exec"
trap 'rm -f "$gate_exec"' EXIT HUP INT TERM
if ! git show :scripts/repository_gate.py >"$gate_exec" 2>/dev/null; then
    echo "[hook] FAIL: staged repository gate is unavailable"
    exit 1
fi
staged_gate_hash=$(git rev-parse :scripts/repository_gate.py 2>/dev/null) || {
    echo "[hook] FAIL: staged repository gate identity is unavailable"
    exit 1
}
materialized_gate_hash=$(git hash-object "$gate_exec" 2>/dev/null) || {
    echo "[hook] FAIL: staged repository gate cannot be verified"
    exit 1
}
if [ "$staged_gate_hash" != "$materialized_gate_hash" ]; then
    echo "[hook] FAIL: staged repository gate identity mismatch"
    exit 1
fi
uv run python "$gate_exec" hook
rm -f "$gate_exec"
trap - EXIT HUP INT TERM

# 4) Typecheck + build the VS Code extension when its source changes — the real gate that catches
#    TS errors before they land. (Packaging/installing the .vsix is a separate manual step, not
#    done here: the .vsix is gitignored, so rebuilding it every commit just burns time.)
if git diff --cached --name-only | grep -q "^clients/vscode/"; then
    if _load_node; then
        echo "[hook] Extension source changed — typechecking (npm run compile)..."
        if ! (cd clients/vscode && npm run compile >/dev/null 2>&1); then
            echo "[hook] FAIL: extension does not compile — fix before committing"
            echo "[hook]   run: (cd clients/vscode && npm run compile)   to see the errors"
            exit 1
        fi
        echo "[hook] Extension compiles."
    else
        echo "[hook] WARN: node not found (nvm not loadable) — skipping extension typecheck"
    fi
fi

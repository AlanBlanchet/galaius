#!/usr/bin/env bash
# This repository is PUBLIC: refuse a push whose commits add private material: machine-local home
#    paths, recorded agent sessions, private notes/research, or any term listed in
#    <git-common-dir>/info/private-terms (.githooks/private-terms.sh) in a diff, a commit message
#    or the pushed ref's name.
set -uo pipefail
. "$(dirname "$0")/private-terms.sh"
terms="$(private_terms)"

zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                      # deleting a remote branch
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes"; else range="$remote_sha..$local_sha"; fi
  # shellcheck disable=SC2086
  added="$(git log -p --no-color --format= $range -- . ':(exclude).githooks' | grep -E '^\+' | grep -Ev '^\+\+\+' || true)"
  # shellcheck disable=SC2086
  paths="$(git log --name-only --format= $range | sort -u)"

  hits="$(printf '%s\n' "$added" | grep -E '/home/[a-z_][a-z0-9_-]*/' | head -5)"
  [ -n "$hits" ] && { echo "pre-push: machine-local home path:" >&2; echo "$hits" >&2; status=1; }

  hits="$(printf '%s\n' "$added" | grep -E '"slash''_commands"' | head -3)"
  [ -n "$hits" ] && { echo "pre-push: recorded agent session (tool/skill roster):" >&2; echo "$hits" | cut -c1-160 >&2; status=1; }

  hits="$(printf '%s\n' "$paths" | grep -E '^\.github/(memory|research)/' | head -5)"
  [ -n "$hits" ] && { echo "pre-push: private notes/research files:" >&2; echo "$hits" >&2; status=1; }

  hits="$(printf '%s\n' "$added" | private_hits "$terms")"
  [ -n "$hits" ] && { echo "pre-push: private term in a diff (info/private-terms):" >&2; echo "$hits" >&2; status=1; }

  # shellcheck disable=SC2086
  hits="$(git log --format=%B $range | private_hits "$terms")"
  [ -n "$hits" ] && { echo "pre-push: private term in a commit message (info/private-terms):" >&2; echo "$hits" >&2; status=1; }

  hits="$(printf '%s\n%s\n' "$_local_ref" "$_remote_ref" | private_hits "$terms")"
  [ -n "$hits" ] && { echo "pre-push: private term in a branch name (info/private-terms):" >&2; echo "$hits" >&2; status=1; }
done

[ "$status" = 0 ] || echo "pre-push: nothing was pushed. Remove the material above (or rewrite those commits) first." >&2
exit "$status"

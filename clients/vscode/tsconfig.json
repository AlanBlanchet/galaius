{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "outDir": "out",
    "rootDir": "src",
    "resolveJsonModule": true,
    "lib": [
      "ES2022"
    ],
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    // The defect this catches, verbatim: `teamSpend` shipped a whole commit imported into
    // chatView.ts and never called, so the feature was dark in the panel while its unit tests and
    // the preview fixture both looked perfect. A hand-kept list of "things that must be used" was
    // the first fix; the compiler already knows, which is strictly better than remembering.
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "webview",
    "src/**/*.test.ts"
  ]
}

{
  "name": "galaius",
  "displayName": "Galaius",
  "description": "Galaius — browser + desktop automation via an MCP server",
  "version": "0.44.2",
  "preview": true,
  "publisher": "AlanBlanchet",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlanBlanchet/galaius"
  },
  "homepage": "https://github.com/AlanBlanchet/galaius#readme",
  "bugs": {
    "url": "https://github.com/AlanBlanchet/galaius/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Testing",
    "Other"
  ],
  "keywords": [
    "mcp",
    "automation",
    "browser",
    "playwright",
    "desktop",
    "agent",
    "vision",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "galaius",
        "label": "Galaius"
      }
    ],
    "configuration": {
      "title": "Galaius",
      "properties": {
        "galaius.projectPath": {
          "type": "string",
          "default": "",
          "description": "DEV ONLY — path to a local galaius checkout to run via 'uv run' instead of the released build. Leave EMPTY (the default) to run the published galaius from GitHub via uvx (zero-config). Never auto-detected, so opening a clone of the repo does not silently run your working tree. Can also be set with the GALAIUS_PROJECT_PATH env var."
        },
        "galaius.display.currency": {
          "type": "string",
          "default": "USD",
          "description": "Currency for displaying spend in the dashboard. Costs are recorded in USD and converted at live ECB rates (frankfurter.app); display-only."
        },
        "galaius.media.backend": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "session",
            "api"
          ],
          "description": "Where image and sampled-video analysis runs. Auto follows the billing policy."
        },
        "galaius.media.billing": {
          "type": "string",
          "default": "session_only",
          "enum": [
            "session_only",
            "api_allowed"
          ],
          "description": "Session only prevents galaius's metered API fallback; vendor CLI account credits are separate."
        },
        "galaius.criteria.weights": {
          "type": "string",
          "default": "",
          "description": "Optional weights over normalized unit-safe criteria only, shared by every role below; raw accuracy, index, latency, and price units cannot be combined."
        },
        "galaius.media.noExtraUsageConfirmedFor": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "claude"
          ],
          "enumDescriptions": [
            "No provider confirmed; sessions run and warn once per process.",
            "Claude only"
          ],
          "markdownDescription": "Provider-scoped confirmation that extra usage is unavailable. For Claude, check [Settings → Usage](https://claude.ai/settings/usage): Usage credits disabled, zero prepaid balance, auto-reload off. Unconfirmed providers still run, with one warning per process. Galaius cannot verify these account settings."
        },
        "galaius.media.providerOrder": {
          "type": "string",
          "default": "claude",
          "enum": [
            "claude"
          ],
          "description": "Media-capable subscription CLI, currently Claude."
        },
        "galaius.media.claudeCriteria": {
          "type": "string",
          "default": "",
          "description": "Requirement the Claude CLI's own model must clear (e.g. 'cap.vlm'); blank uses its subscription default."
        },
        "galaius.tierSovereign.criteria": {
          "type": "string",
          "default": "",
          "description": "Requirement for review_ui/verify_ui's low/medium quality tier (cheapest clearing model wins — self-hosted sorts first at zero cost); blank means any VLM."
        },
        "galaius.media.timeout": {
          "type": "number",
          "default": 120,
          "description": "Hard timeout in seconds for a subscription media child process."
        },
        "galaius.media.maxItems": {
          "type": "number",
          "default": 16,
          "description": "Maximum number of image, video, or audio items accepted in one analysis."
        },
        "galaius.media.maxTotalBytes": {
          "type": "number",
          "default": 52428800,
          "description": "Maximum aggregate decoded media bytes accepted before any provider runs."
        },
        "galaius.media.maxContextChars": {
          "type": "number",
          "default": 32768,
          "description": "Maximum untrusted page, title, URL, or transcript context characters per request."
        },
        "galaius.image.criteria": {
          "type": "string",
          "default": "",
          "description": "Requirement for screenshots and images (e.g. 'cap.vlm and aa.intelligence > 80%'); blank means any VLM. Subscription sessions use galaius.media.claudeCriteria instead."
        },
        "galaius.video.criteria": {
          "type": "string",
          "default": "",
          "description": "Requirement for video (falls back to cap.video). Subscription sessions always receive ordered sampled frames; APIs may use native video when supported."
        },
        "galaius.video.fps": {
          "type": "number",
          "default": 5,
          "description": "Frames per second for video capture"
        },
        "galaius.video.duration": {
          "type": "number",
          "default": 3,
          "description": "Duration in seconds for video capture"
        },
        "galaius.component.criteria": {
          "type": "string",
          "default": "",
          "description": "Requirement for GUI grounding (falls back to cap.gui_grounding). Subscription sessions use their media session model."
        },
        "galaius.audio.criteria": {
          "type": "string",
          "default": "",
          "description": "Requirement for transcribe (falls back to cap.audio). Claude subscription sessions do not hear audio; galaius.media.billing must allow this separate path."
        },
        "galaius.browser.headless": {
          "type": "boolean",
          "default": true,
          "description": "Run browser in headless mode"
        },
        "galaius.browser.type": {
          "type": "string",
          "default": "chromium",
          "enum": [
            "chromium",
            "firefox",
            "webkit"
          ],
          "description": "Browser engine"
        },
        "galaius.browser.viewportWidth": {
          "type": "number",
          "default": 1280,
          "minimum": 1,
          "description": "Browser viewport width"
        },
        "galaius.browser.viewportHeight": {
          "type": "number",
          "default": 720,
          "minimum": 1,
          "description": "Browser viewport height"
        },
        "galaius.browser.slowMo": {
          "type": "number",
          "default": 0,
          "description": "Slow down browser actions by this many milliseconds (useful for observing automation)"
        },
        "galaius.browser.profileDir": {
          "type": "string",
          "default": "",
          "description": "When set, browser sessions keep their cookies/login on disk here (under <dir>/<session>) so you log in once and stay authenticated across restarts. Blank = ephemeral (logged out every launch)."
        },
        "galaius.vlm.maxTokens": {
          "type": "number",
          "default": 2048,
          "description": "Maximum tokens for VLM vision responses"
        },
        "galaius.vlm.waitTimeout": {
          "type": "number",
          "default": 10000,
          "description": "Default timeout in ms for waiting on elements"
        },
        "galaius.debug.dir": {
          "type": "string",
          "default": "~/.galaius/out",
          "description": "Where galaius writes the usage log + debug artifacts (blank = ~/.galaius/out; point at a project's out/ when working locally). Must match GALAIUS_DEBUG_DIR — the dashboard reads the usage log from here."
        },
        "galaius.desktop.target": {
          "type": "string",
          "default": "local",
          "enum": [
            "local",
            "nested"
          ],
          "enumDescriptions": [
            "Drive the real desktop session (system-wide input + capture)",
            "Drive an isolated nested display (Xephyr) — a sandbox that never touches your real windows or cursor"
          ],
          "description": "Where desktop automation acts: the real session, or an isolated nested display"
        },
        "galaius.desktop.nestedDisplay": {
          "type": "number",
          "default": 99,
          "description": "X display number for the nested desktop target (e.g. 99 → :99)"
        },
        "galaius.desktop.nestedSize": {
          "type": "string",
          "default": "1280x800",
          "pattern": "^[1-9]\\d*x[1-9]\\d*$",
          "description": "Screen size of the nested desktop target (WIDTHxHEIGHT)"
        },
        "galaius.desktop.nestedHeadless": {
          "type": "boolean",
          "default": true,
          "description": "Nested target only: ON = Xvfb in the background (CI/servers); OFF = Xephyr you can watch"
        }
      }
    },
    "commands": [
      {
        "command": "galaius.workspace",
        "title": "Galaius: Server Workspace"
      },
      {
        "command": "galaius.selectModel",
        "title": "Galaius: Select Model"
      },
      {
        "command": "galaius.manageApiKeys",
        "title": "Galaius: Manage API Keys"
      },
      {
        "command": "galaius.openDashboard",
        "title": "Galaius: Open Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "galaius.reloadPanel",
        "title": "Galaius: Reload Panel"
      },
      {
        "command": "galaius.agents.refresh",
        "title": "Refresh agents",
        "category": "Galaius",
        "icon": "$(refresh)"
      },
      {
        "command": "galaius.agents.groupBy",
        "title": "Group agents by…",
        "category": "Galaius",
        "icon": "$(list-tree)"
      },
      {
        "command": "galaius.agents.stop",
        "title": "Stop agent",
        "category": "Galaius",
        "icon": "$(debug-stop)"
      },
      {
        "command": "galaius.agents.showEvents",
        "title": "Show agent activity",
        "category": "Galaius",
        "icon": "$(output)"
      },
      {
        "command": "galaius.agents.openConversation",
        "title": "Open agent conversation",
        "category": "Galaius",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "galaius.agents.show",
        "title": "Galaius: Show Agents Panel"
      },
      {
        "command": "galaius.agents.sequence",
        "title": "Show agent sequence",
        "category": "Galaius",
        "icon": "$(git-merge)"
      },
      {
        "command": "galaius.agents.send",
        "title": "Send message to agent",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "galaius.agents.team",
        "title": "Galaius: Show Team",
        "icon": "$(organization)"
      },
      {
        "command": "galaius.agents.newSession",
        "title": "Galaius: New Session",
        "icon": "$(add)"
      },
      {
        "command": "galaius.agents.spawn",
        "title": "Galaius: Start an Agent",
        "icon": "$(person-add)"
      },
      {
        "command": "galaius.agents.providers",
        "title": "Galaius: Providers That Run Agents",
        "icon": "$(plug)"
      },
      {
        "command": "galaius.agents.workspace",
        "title": "Galaius: Show Agents From Workspace…",
        "icon": "$(folder-library)"
      },
      {
        "command": "galaius.agents.pick",
        "title": "Galaius: Read an Agent…",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "galaius.agents.broadcast",
        "title": "Galaius: Message Every Running Agent…",
        "icon": "$(megaphone)"
      },
      {
        "command": "galaius.agents.permissions",
        "title": "Galaius: Default Agent Autonomy…",
        "icon": "$(shield)"
      },
      {
        "command": "galaius.showLogs",
        "title": "Galaius: Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "galaius.agents.backToTeam",
        "title": "Back to the Team",
        "category": "Galaius"
      },
      {
        "command": "galaius.agents.model",
        "title": "Choose the Model an Agent Runs On",
        "category": "Galaius"
      },
      {
        "command": "galaius.agents.agent",
        "title": "Show an Agent and the Tasks It Was Given",
        "category": "Galaius"
      },
      {
        "command": "galaius.agents.definition",
        "title": "Open an Agent's Instructions",
        "category": "Galaius"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "galaiusAgentsSecondary",
          "title": "Galaius",
          "icon": "media/galaius.svg"
        }
      ]
    },
    "views": {
      "galaiusAgentsSecondary": [
        {
          "id": "galaiusAgents.chat",
          "name": "Conversation",
          "type": "webview",
          "contextualTitle": "Galaius agent chat",
          "visibility": "visible",
          "initialSize": 5
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "galaius.agents.team",
          "when": "view == galaiusAgents.board",
          "group": "navigation@0"
        },
        {
          "command": "galaius.agents.spawn",
          "when": "view == galaiusAgents.board",
          "group": "navigation@1"
        },
        {
          "command": "galaius.agents.workspace",
          "when": "view == galaiusAgents.board",
          "group": "navigation@2"
        },
        {
          "command": "galaius.agents.refresh",
          "when": "view == galaiusAgents.board",
          "group": "navigation@3"
        },
        {
          "command": "galaius.agents.sequence",
          "when": "view == galaiusAgents.board",
          "group": "1_galaius@0"
        },
        {
          "command": "galaius.agents.groupBy",
          "when": "view == galaiusAgents.board",
          "group": "1_galaius@1"
        },
        {
          "command": "galaius.openDashboard",
          "when": "view == galaiusAgents.board",
          "group": "1_galaius@2"
        },
        {
          "command": "galaius.agents.providers",
          "when": "view == galaiusAgents.board",
          "group": "1_galaius@3"
        },
        {
          "command": "galaius.showLogs",
          "when": "view == galaiusAgents.board",
          "group": "1_galaius@4"
        },
        {
          "command": "galaius.agents.team",
          "when": "view == galaiusAgents.chat",
          "group": "navigation@0"
        },
        {
          "command": "galaius.agents.spawn",
          "when": "view == galaiusAgents.chat",
          "group": "navigation@1"
        },
        {
          "command": "galaius.agents.pick",
          "when": "view == galaiusAgents.chat",
          "group": "navigation@2"
        },
        {
          "command": "galaius.agents.sequence",
          "when": "view == galaiusAgents.chat",
          "group": "1_galaius@0"
        },
        {
          "command": "galaius.openDashboard",
          "when": "view == galaiusAgents.chat",
          "group": "1_galaius@1"
        },
        {
          "command": "galaius.agents.providers",
          "when": "view == galaiusAgents.chat",
          "group": "1_galaius@2"
        },
        {
          "command": "galaius.showLogs",
          "when": "view == galaiusAgents.chat",
          "group": "1_galaius@3"
        }
      ],
      "view/item/context": [
        {
          "command": "galaius.agents.openConversation",
          "when": "view == galaiusAgents.board && viewItem =~ /galaius(Running|Foreign)?Run/",
          "group": "inline@0"
        },
        {
          "command": "galaius.agents.stop",
          "when": "view == galaiusAgents.board && viewItem == galaiusRunningRun",
          "group": "inline"
        },
        {
          "command": "galaius.agents.showEvents",
          "when": "view == galaiusAgents.board && viewItem =~ /galaius(Running)?Run/",
          "group": "inline"
        },
        {
          "command": "galaius.agents.send",
          "when": "view == galaiusAgents.board && viewItem =~ /galaius(Running)?Run/",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "galaius.agents.broadcast",
          "when": "false"
        },
        {
          "command": "galaius.agents.definition",
          "when": "false"
        },
        {
          "command": "galaius.agents.groupBy",
          "when": "false"
        },
        {
          "command": "galaius.agents.model",
          "when": "false"
        },
        {
          "command": "galaius.agents.openConversation",
          "when": "false"
        },
        {
          "command": "galaius.agents.refresh",
          "when": "false"
        },
        {
          "command": "galaius.agents.send",
          "when": "false"
        },
        {
          "command": "galaius.agents.showEvents",
          "when": "false"
        },
        {
          "command": "galaius.agents.stop",
          "when": "false"
        },
        {
          "command": "galaius.agents.spawn",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run check-css && bash scripts/generate-types.sh && node scripts/sync-data.js && tsc -p ./ && tsc -p webview/tsconfig.json && node -e \"try{require('fs').cpSync('src/models.json','out/models.json')}catch{}\" && node -e \"try{require('fs').cpSync('src/benchmarks.json','out/benchmarks.json')}catch{}\" && node -e \"try{require('fs').cpSync('src/settings.json','out/settings.json')}catch{}\" && npm run build:webview && npm run build:workplace",
    "build:webview": "esbuild webview/app.tsx --bundle --outfile=out/webview.js --format=iife --target=es2022 --jsx=automatic --jsx-import-source=. && cp webview/styles.css out/webview.css",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && npx @vscode/vsce package",
    "publish": "npm run compile && npx @vscode/vsce publish",
    "generate-models": "uv run --project .. python scripts/generate-models.py",
    "generate-benchmarks": "uv run --project .. python scripts/generate-benchmarks.py",
    "test:vscode": "npm run compile && tsc -p tsconfig.test.json && vscode-test",
    "build:workplace": "esbuild webview/workplace/index.ts --bundle --outfile=out/workplace.js --format=cjs --platform=node --target=es2022",
    "test": "node --test --experimental-strip-types src/*.test.ts",
    "check-css": "node scripts/check-css-templates.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.99.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.5.0",
    "esbuild": "^0.25.0",
    "json-schema-to-typescript": "^15.0.4",
    "mocha": "^11.8.0",
    "typescript": "^5.7.0"
  }
}
